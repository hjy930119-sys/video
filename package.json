{
  "name": "frame-studio",
  "version": "0.2.0",
  "description": "Local video editor with Korean captions and image overlays",
  "main": "main.cjs",
  "author": "Frame Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "@playwright/test": "^1.58.0"
  },
  "build": {
    "appId": "com.framestudio.editor",
    "productName": "Frame Studio",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "engine.cjs",
      "ui/**",
      "package.json",
      "README.md",
      "THIRD_PARTY.md",
      "LICENSE",
      "!ui/fixture.*",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffmpeg-static/ffmpeg.LICENSE",
      "!node_modules/ffmpeg-static/ffmpeg.README"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Frame Studio",
      "artifactName": "Frame-Studio-${version}-Setup.exe",
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "Frame-Studio-${version}-Portable.exe"
    }
  }
}

